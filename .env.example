# ===========================================
# 环境变量配置模板
# 复制此文件为 .env 并填入真实值
# cp .env.example .env
# ===========================================

# ---- MySQL 数据库 ----
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DB=qk
MYSQL_USER=qk
MYSQL_PASSWORD=CHANGE_ME          # 数据库用户密码
MYSQL_ROOT_PASSWORD=CHANGE_ME     # MySQL root 密码（首次初始化用）

# ---- 前端 ----
APP_PORT=90                       # 前端访问端口

# ---- 阿里云 OSS ----
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com   # OSS 节点，根据 Bucket 所在地域修改
OSS_BUCKET_NAME=your-bucket-name           # Bucket 名称
OSS_ACCESS_KEY_ID=your-access-key-id       # AccessKey ID（RAM 子账号）
OSS_ACCESS_KEY_SECRET=your-access-key-secret  # AccessKey Secret
