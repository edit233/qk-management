# ============================================================================
# qk-management 服务器侧密钥模板（占位符版，提交到 git）
# ============================================================================
# 用法：
#   cp .env.example .env
#   vi .env           # 把占位符替换成真实值
#
# ⚠️  .env 已被 .gitignore / .dockerignore 排除，绝不能进入 git 仓库。
# ⚠️  本文件不含任何真实密钥，仅作为字段清单与示例格式。
# ⚠️  如发现 .env 被误提交，立刻吊销相关密钥（详见 README §6.6）。
# ============================================================================

# ---------- GHCR 镜像仓库 ----------
# GitHub 用户名或组织名（小写，不带 @），对应流水线中镜像的 owner
GHCR_OWNER=your-github-username

# 可选：GHCR 私有包时才需要。
# 在 GitHub Packages 中把包设为 public 后，可删除此项（推荐公开以简化部署）。
# 创建 PAT：https://github.com/settings/tokens   → 勾选 read:packages
# GHCR_TOKEN=ghp_replace_with_real_token

# ---------- MySQL 数据库 ----------
# 容器内访问用 "mysql"；外部 MySQL 改为 IP 地址
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DB=qk
MYSQL_USER=qk
MYSQL_PASSWORD=replace_with_real_password

# ---------- 阿里云 OSS ----------
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_BUCKET_NAME=your-bucket-name
OSS_ACCESS_KEY_ID=replace_with_real_ak
OSS_ACCESS_KEY_SECRET=replace_with_real_sk

# ---------- 端口（可选，默认 90 / 8080） ----------
# APP_PORT=90
# BACKEND_PORT=8080