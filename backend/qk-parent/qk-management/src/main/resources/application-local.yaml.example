# ============================================================================
# 本地配置覆盖层（可选，提交到 git 作为参考）
# ============================================================================
# application.yaml 已经用 ${PLACEHOLDER:默认值} 提供开箱即用的开发配置：
#   - 数据库：localhost:3306 / root / 123456（开发常用值）
#   - OSS：占位符（启动正常，调用时失败）
#
# 如果你的本地环境和默认值不同，请按下面步骤创建 application-local.yaml：
#   1. cp application-local.yaml.example application-local.yaml
#   2. 取消注释并修改对应字段
#   3. IDEA Run 会自动加载（profiles.active=local 已在 application.yaml 默认设置）
#
# ⚠️ application-local.yaml 已在 .gitignore 中屏蔽，绝不会被提交。
# ⚠️ 真实密钥（OSS_ACCESS_KEY_SECRET 等）严禁提交到任何文件。
# ============================================================================

# 示例：修改本地 MySQL 密码
# spring:
#   datasource:
#     password: my_local_password

# 示例：填入本地 OSS 凭证
# qk:
#   oss:
#     bucket-name: my-personal-bucket
#     access-key-id: LTAI5tMyAkId
#     access-key-secret: myRealSecretKey123

# 示例：开发期想看 SQL 日志
# logging:
#   level:
#     com.qk.mapper: debug